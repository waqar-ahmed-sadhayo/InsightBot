# Copy to .env and fill in real values. All settings have safe local
# defaults (see insightbot/settings.py) except the admin bootstrap creds.

# --- Networking ---
INSIGHTBOT_REQUEST_TIMEOUT=5
INSIGHTBOT_MAX_RETRIES=2
INSIGHTBOT_USER_AGENT=InsightBotCrawler/0.1 (+https://example.com/bot; contact=admin@example.com)

# --- Article storage backend: none | mongo | mysql ---
INSIGHTBOT_DB_BACKEND=none

INSIGHTBOT_MONGO_URI=mongodb://localhost:27017
INSIGHTBOT_MONGO_DB=insightbot

INSIGHTBOT_MYSQL_HOST=localhost
INSIGHTBOT_MYSQL_PORT=3306
INSIGHTBOT_MYSQL_USER=root
INSIGHTBOT_MYSQL_PASSWORD=
INSIGHTBOT_MYSQL_DB=insightbot

# --- Flask API (user accounts, JWT) ---
INSIGHTBOT_SECRET_KEY=change-me-to-a-random-string
INSIGHTBOT_JWT_EXPIRES_HOURS=12
# Leave unset to use the absolute-path default in insightbot/settings.py
# (<project_root>/data/insightbot_app.db). If you do set this, use an
# ABSOLUTE path -- Flask-SQLAlchemy resolves a relative "sqlite:///..."
# URI against the Flask app's instance_path (not the process cwd), so a
# relative path here fails with "unable to open database file".
# INSIGHTBOT_SQLALCHEMY_URI=sqlite:////absolute/path/to/data/insightbot_app.db

# First admin account, created automatically on first app start if no
# admin exists yet. Required so someone can approve the first real user.
INSIGHTBOT_ADMIN_EMAIL=admin@example.com
INSIGHTBOT_ADMIN_PASSWORD=change-me-please

# --- Scheduler (UTC) ---
INSIGHTBOT_DAILY_RUN_HOUR=3
INSIGHTBOT_DAILY_RUN_MINUTE=0
